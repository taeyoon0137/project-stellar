{
  "format": "stellar-agent-e2e-scenario/1",
  "id": "decode-failure",
  "title": "디코드 실패 후 적용 변경 유지와 권한·lease 확대 0",
  "profile": "claude",
  "mode": "apply-in-scope",
  "double": [
    "read-line",
    "chunk 9",
    "outfile decoder/claude-stream-json/fail-invalid-json.jsonl",
    "sleep 50",
    "out after-failure\\n",
    "hang"
  ],
  "steps": [
    {"at": 0, "do": "start"},
    {"at": 1, "do": "launch", "prompt": "아이콘 정렬을 고쳐 줘"},
    {"at": 2, "do": "bridge-bound"},
    {"at": 3, "do": "grant", "permission": "read"},
    {"at": 3, "do": "grant", "permission": "apply"},
    {"at": 4, "do": "open-scope", "targets": 1},
    {"at": 5, "do": "answer", "request": 1, "answer": "approve"},
    {"at": 6, "do": "lease", "lease": 1},
    {"at": 7, "do": "apply", "batch": 0, "history": 7},
    {"at": 8, "do": "await-output", "until": "decode-failed"},
    {"at": 9, "do": "check", "state": "running", "leases": 1, "pending_requests": 0, "applied": 1,
      "permissions": ["read", "apply"], "effects": [], "chat": ["user-prompt", "decode-stopped"],
      "outcomes": ["approved"], "app": ["applied-batches-kept", "no-auto-rollback"]}
  ]
}
