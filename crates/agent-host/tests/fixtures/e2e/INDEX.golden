scenario decode-failure profile=claude mode=apply-in-scope
  double read-line
  double chunk 9
  double outfile decoder/claude-stream-json/fail-invalid-json.jsonl
  double sleep 50
  double out after-failure\n
  double hang
       0 start
       1 launch prompt="아이콘 정렬을 고쳐 줘"
