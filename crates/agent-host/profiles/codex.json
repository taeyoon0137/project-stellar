{
  "format": "stellar-launch-profile/1",
  "id": "codex-exec-0",
  "cli": "codex",
  "display_name": "Codex CLI",
  "enabled": false,
  "versions": { "min": "0.1.0", "max_exclusive": "1.0.0" },
  "team_id": null,
  "version_command": ["--version"],
  "status_command": ["login", "status"],
  "status_rule": "exit-code",
  "session_command": [
    "exec",
    "--json",
    "--ephemeral",
    "--skip-git-repo-check",
    "--sandbox", "read-only",
    "-"
  ],
  "input": "stdin-text-once",
  "decoder": { "id": "codex-exec-jsonl", "version": 1 },
  "env": [
    "HOME",
    "PATH",
    "USER",
    "LOGNAME",
    "TMPDIR",
    "LANG",
    "LC_ALL",
    "LC_CTYPE",
    "CODEX_HOME",
    "HTTPS_PROXY",
    "HTTP_PROXY",
    "NO_PROXY"
  ],
  "timeouts_ms": { "version": 5000, "status": 10000, "startup": 60000, "terminate_grace": 3000 },
  "review": {
    "terms_date": "2026-11-23",
    "terms_result": "pending",
    "docs_date": "2026-11-23",
    "docs": [
      "https://learn.chatgpt.com/docs/non-interactive-mode"
    ],
    "note": "약관 검토, 서명 Team ID, MCP 서버 연결 방법과 login status 종료 코드 확인 전이라 활성 목록에 넣지 않음"
  }
}
