#!/bin/sh
#
# commit-msg 훅: 커밋 메시지 제목 형식을 강제합니다.
#   - 구현 작업: Task(<WBS-ID>): <제목>   (예: Task(I.1.1): 저장소 기준선 검증)
#   - 유지보수:  <Prefix>: <제목>          (Prefix: Feat | Docs | Refactor | Fix | Chore | Test)
#   - Task와 Prefix는 영문, 제목은 한국어 권장. 제목은 비어 있으면 안 됩니다.
#   - WBS-ID는 로마 숫자 Phase 번호와 점으로 구분한 번호입니다(예: I, I.1, I.1.1).
#
# 활성화: git config core.hooksPath .githooks

commit_msg_file="$1"

# 머지/리버트/자동 생성(fixup!, squash!) 커밋은 형식 검사를 건너뜁니다.
first_line=$(sed -n '1p' "$commit_msg_file")
case "$first_line" in
  "Merge "*|"Revert "*|fixup!*|squash!*)
    exit 0
    ;;
esac

# 주석(#)과 빈 줄을 제외한 첫 줄을 제목으로 사용합니다.
subject=$(grep -vE '^[[:space:]]*#' "$commit_msg_file" | grep -m1 -vE '^[[:space:]]*$')

if printf '%s\n' "$subject" | grep -qE '^(Task\([IVXLCDM]+(\.[0-9]+)*\)|Feat|Docs|Refactor|Fix|Chore|Test): .+'; then
  exit 0
fi

{
  echo "✖ 커밋 메시지 형식 오류"
  echo
  echo "허용 형식 (Task와 Prefix는 영문, 제목은 한국어):"
  echo "  - 구현 작업: Task(<WBS-ID>): <제목>   예: Task(I.1.1): 저장소 기준선 검증"
  echo "  - 유지보수:  <Prefix>: <제목>          예: Docs: 기술 아키텍처 정의서 추가"
  echo "  Prefix: Feat | Docs | Refactor | Fix | Chore | Test"
  echo
  echo "입력한 제목: ${subject}"
} >&2

exit 1
